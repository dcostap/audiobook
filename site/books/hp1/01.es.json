":[3,4,5],"es":"un hijo pequeño"},{"t":[6],"es":"llamado"},{"t":[7],"es":"Dudley"},{"t":[8],"es":"y"},{"t":[9,10,11],"es":"en su opinión"},{"t":[12,13],"es":"no había"},{"t":[14,15,16],"es":"ningún chico mejor"},{"t":[17],"es":"en ninguna parte"}]},{"es":"Los Dursley tenían todo lo que querían, pero también guardaban un secreto, y su mayor temor era que alguien lo descubriera.","units":[{"t":[0,1],"es":"los Dursley"},{"t":[2],"es":"tenían","base":"have (had, had)"},{"t":[3,4,5],"es":"todo lo que querían"},{"t":[6],"es":"pero"},{"t":[7,8,9],"es":"también tenían","base":"have (had, had)"},{"t":[10,11],"es":"un secreto"},{"t":[12],"es":"y"},{"t":[13,14,15],"es":"su mayor temor"},{"t":[16],"es":"era","base":"be (was, were)"},{"t":[17],"es":"que"},{"t":[18],"es":"alguien"},{"t":[19,20,21],"es":"lo descubriera"}]},{"es":"No creían que pudieran soportarlo si alguien se enteraba de los Potter.","units":[{"t":[0],"es":"ellos"},{"t":[1,2],"es":"no creían"},{"t":[3],"es":"ellos"},{"t":[4,5,6],"es":"pudieran soportarlo","note":"Aquí, *bear it* significa aguantar o soportar una situación, no llevar algo físicamente."},{"t":[7],"es":"si"},{"t":[8],"es":"alguien"},{"t":[9,10,11],"es":"se enteraba de","base":"find out about (found, found)"},{"t":[12,13],"es":"los Potter"}]},{"es":"La señora Potter era hermana de la señora Dursley, pero hacía varios años que no se veían; de hecho, la señora Dursley fingía no tener hermana, porque su hermana y su inútil marido eran lo menos Dursley posible.","units":[{"t":[0,1],"es":"la señora Potter"},{"t":[2],"es":"era","base":"be (was, were)"},{"t":[3,4],"es":"de la señora Dursley"},{"t":[5],"es":"hermana"},{"t":[6],"es":"pero"},{"t":[7,8,9],"es":"no se habían visto","base":"meet (met, met)"},{"t":[10,11,12],"es":"desde hacía varios años"},{"t":[13,14],"es":"de hecho"},{"t":[15,16],"es":"la señora Dursley"},{"t":[17],"es":"fingía"},{"t":[18,19,20],"es":"no tener"},{"t":[21,22],"es":"una hermana"},{"t":[23],"es":"porque"},{"t":[24,25],"es":"su hermana"},{"t":[26],"es":"y"},{"t":[27,28,29],"es":"su inútil marido","note":"*Good-for-nothing* es despectivo: alguien que no vale para nada o no da golpe."},{"t":[30],"es":"eran","base":"be (was, were)"},{"t":[31,32,33,34,35,36,37,38],"es":"lo menos Dursley posible","note":"Palabra inventada: juega con *Dursleyish* («propio de los Dursley») y *un-* («no»)."}]},{"es":"A los Dursley les daba escalofríos pensar qué dirían los vecinos si los Potter llegaran a la calle.","units":[{"t":[0,1],"es":"los Dursley"},{"t":[2,3,4],"es":"les daba escalofríos pensar"},{"t":[5],"es":"qué"},{"t":[6,7],"es":"los vecinos"},{"t":[8,9],"es":"dirían"},{"t":[10],"es":"si"},{"t":[11,12],"es":"los Potter"},{"t":[13],"es":"llegaran"},{"t":[14,15,16],"es":"por la calle"}]},{"es":"Los Dursley sabían que los Potter también tenían un hijo pequeño, pero ni siquiera lo habían visto.","units":[{"t":[0,1],"es":"los Dursley"},{"t":[2],"es":"sabían","base":"know (knew, known)"},{"t":[3],"es":"que"},{"t":[4,5],"es":"los Potter"},{"t":[6],"es":"tenían","base":"have (had, had)"},{"t":[7,8,9],"es":"un hijo pequeño"},{"t":[10],"es":"también"},{"t":[11],"es":"pero"},{"t":[12],"es":"ellos"},{"t":[14,15],"es":"ni siquiera"},{"t":[13,16,17],"es":"lo habían visto","base":"see (saw, seen)"}]},{"es":"Ese niño era otro buen motivo para mantener alejados a los Potter; no querían que Dudley se juntara con un niño así.","units":[{"t":[0,1],"es":"ese niño"},{"t":[2],"es":"era","base":"be (was, were)"},{"t":[3,4,5],"es":"otro buen motivo"},{"t":[6,7,8,9,10],"es":"para mantener alejados a los Potter","base":"keep away"},{"t":[11],"es":"ellos"},{"t":[12,13],"es":"no querían"},{"t":[14],"es":"Dudley"},{"t":[15,16],"es":"se juntara con","base":"mix with (mixed, mixed)"},{"t":[17,18,19,20],"es":"un niño así"}]},{"es":"Cuando el señor y la señora Dursley se despertaron aquel martes gris y apagado en que empieza nuestra historia, no había nada en el cielo nublado de fuera que sugiriera que pronto ocurrirían cosas extrañas y mis